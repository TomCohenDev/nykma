---
// Where the sales form lands without JavaScript, when it sent (worker/index.ts).
import Term from "../../layouts/Term.astro";
---

<Term title="Sent to sales" description="Your message reached nykma sales.">
  <section class="t-wrap note">
    <h1 class="t-h1">Sent to sales<span class="cur"></span></h1>
    <p class="t-lede">
      The reply will come to the email you gave. If it doesn't arrive, email
      <a href="mailto:sales@nobodyknowsmyapp.com">sales@nobodyknowsmyapp.com</a>.
    </p>
    <div class="t-btns"><a class="t-btn" href="/pricing">back to pricing</a></div>
  </section>
</Term>

<style>
  .note {
    padding-top: clamp(80px, 14vw, 180px);
    text-align: center;
  }
  .note .t-lede {
    margin-left: auto;
    margin-right: auto;
    color: var(--dim);
  }
  .note .t-btns {
    justify-content: center;
  }
</style>
