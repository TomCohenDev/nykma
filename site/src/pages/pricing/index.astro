---
// Pricing, in the look of /v/1 (layouts/Term.astro): free for personal use, a commercial licence for any company,
// asked for through the sales form, which posts to worker/index.ts and works without JavaScript too.
import Term from "../../layouts/Term.astro";
import Install from "../../components/Install.astro";

const sizes = ["just me", "2–10", "11–50", "51–200", "more than 200"];
const repo = "https://github.com/TomCohenDev/nykma";
const questions: [string, string][] = [
  ["I make ads for clients as a freelancer.", "That's commercial use: you need the company licence, even working alone."],
  ["We're a charity, a school or a public research group.", "Free, under the same licence as personal use."],
  ["Is the company version a different nykma?", "No. It's the same code with the same features. The licence is what changes."],
  [
    "Does the licence cover the services nykma calls?",
    "No. An ElevenLabs voice needs a paid ElevenLabs plan for commercial use, and generated media, stock and the LTX-2.5 video model each have their own licence.",
  ],
];
---

<Term
  title="nykma pricing"
  description="nykma is free for personal use. Every company needs a commercial licence: tell sales about the team and get a price."
>
  <section class="t-wrap hero">
    <h1 class="title">
      The plan for the app you're launching next
    </h1>
    <p class="lede">
      From side projects to companies, and launch videos to ads. Find the plan that fits you.
    </p>
  </section>

  <div class="t-wrap plans">
    <section class="plan" aria-labelledby="personal">
      <p class="plan-name" id="personal">personal</p>
      <p class="price">free</p>
      <ul class="list">
        <li>ads for yourself, a side project or your own learning</li>
        <li>read it, change it, and share your changes for noncommercial use</li>
        <li>charities, schools and public research too</li>
      </ul>
      <div class="install"><Install /></div>
      <p class="small">
        Licensed under <a href={`${repo}/blob/main/LICENSE`}>PolyForm Noncommercial 1.0.0</a>.
      </p>
    </section>

    <section class="plan company" id="sales" aria-labelledby="company-title">
      <p class="plan-name" id="company-title">company</p>
      <p class="price">ask sales</p>
      <p class="plan-p">
        Any company, including a one-person company or a freelancer making ads for clients. One licence covers everyone
        in the company. Say who you are and how many people will use it, and you'll get a price by email.
      </p>

      <form class="form" action="/api/contact" method="post" novalidate data-sales>
        <div class="row">
          <div class="field">
            <label for="name">your name</label>
            <input id="name" name="name" autocomplete="name" maxlength="100" required />
          </div>
          <div class="field">
            <label for="email">work email</label>
            <input id="email" name="email" type="email" autocomplete="email" maxlength="200" required />
          </div>
        </div>
        <div class="field">
          <label for="company">company</label>
          <input id="company" name="company" autocomplete="organization" maxlength="150" required />
        </div>
        <fieldset class="field">
          <legend>people using nykma</legend>
          <div class="sizes" id="size">
            {
              sizes.map((size) => (
                <label>
                  <input type="radio" name="size" value={size} required />
                  <span>{size}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div class="field">
          <label for="message">anything else <span class="hint">(optional)</span></label>
          <textarea id="message" name="message" maxlength="4000" placeholder="what you'll make with it, or a question"
          ></textarea>
        </div>
        <div class="trap" aria-hidden="true">
          <label for="website">leave this empty</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="send">
          <button type="submit" class="t-btn primary">send to sales</button>
          <span class="or">or email <a href="mailto:sales@nobodyknowsmyapp.com">sales@nobodyknowsmyapp.com</a></span>
        </div>
        <p class="status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </div>

  <section class="t-wrap faq" aria-labelledby="faq">
    <h2 class="h2" id="faq">Which one is mine?</h2>
    <dl>
      {
        questions.map(([q, a]) => (
          <div class="qa">
            <dt>{q}</dt>
            <dd>{a}</dd>
          </div>
        ))
      }
    </dl>
    <p class="small">
      Every service and its terms are listed in <a href={`${repo}/blob/main/COMMERCIAL.md`}>COMMERCIAL.md</a>.
    </p>
  </section>
</Term>

<style>
  .h2 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(28px, 3.8vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .small {
    color: var(--dim);
    font-size: 15px;
    margin: 20px 0 0;
  }

  /* ---------- the words at the top, centred like /v/1 ---------- */
  .hero {
    text-align: center;
    padding-top: clamp(56px, 9vw, 110px);
  }
  .title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(34px, 5.6vw, 72px);
    line-height: 1.06;
    letter-spacing: -0.045em;
    max-width: 16em;
    margin-inline: auto;
    text-wrap: balance;
  }
  .lede {
    max-width: 56ch;
    margin: 30px auto 0;
    color: var(--dim);
  }

  /* ---------- the two plans ---------- */
  .plans {
    display: grid;
    gap: 24px;
    margin-top: clamp(56px, 8vw, 96px);
  }
  @media (min-width: 960px) {
    .plans {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }
  }
  .plan {
    min-width: 0;
    background: var(--raise);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: clamp(22px, 3.4vw, 40px);
  }
  .company {
    border-color: var(--red);
    box-shadow: 0 0 0 1px var(--red);
  }
  .plan-name {
    margin: 0;
    font: 700 13px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .price {
    margin: 14px 0 0;
    font-weight: 800;
    font-size: clamp(36px, 4.4vw, 52px);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .company .price {
    color: var(--red);
  }
  .plan-p {
    margin: 22px 0 0;
  }
  .list {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }
  .list li {
    padding-left: 1.4em;
    text-indent: -1.4em;
    margin-top: 8px;
  }
  .list li::before {
    content: "> ";
    color: var(--red);
  }
  .install {
    margin-top: 28px;
  }
  .install :global(.in-box) {
    background: var(--deep);
  }
  /* The card is narrower than the start section: the copy button gets its own row above the commands. */
  .install :global(.in-box .in-cmds) {
    padding: 50px 18px 16px;
    font-size: 13.5px;
  }
  .install :global(.in-then),
  .install :global(.in-needs) {
    font-size: 15px;
  }

  /* ---------- the form ---------- */
  .form {
    display: grid;
    gap: 20px;
    margin-top: 30px;
  }
  .row {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 560px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field label,
  .field legend {
    display: block;
    margin: 0 0 8px;
    padding: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--dim);
  }
  .hint {
    font-weight: 400;
  }
  .field input,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: 16px;
    color: var(--paper);
    background: var(--deep);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 11px 13px;
  }
  .field input:hover,
  .field textarea:hover {
    border-color: #4a4a4a;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline-offset: 0;
    border-color: var(--red);
  }
  .field textarea {
    min-height: 110px;
    resize: vertical;
  }
  .field textarea::placeholder {
    color: #6b665e;
  }
  .field [aria-invalid="true"] {
    border-color: var(--red);
    box-shadow: 0 0 0 1px var(--red);
  }
  fieldset.field {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sizes label {
    margin: 0;
    position: relative;
  }
  .sizes input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .sizes span {
    display: inline-block;
    padding: 7px 14px;
    font-size: 15px;
    color: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--deep);
    cursor: pointer;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .sizes span:hover {
    border-color: var(--paper);
  }
  .sizes input:checked + span {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }
  .sizes input:focus-visible + span {
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }
  .sizes[aria-invalid="true"] span {
    border-color: var(--red);
  }
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-top: 4px;
  }
  .send button {
    font-family: var(--mono);
    cursor: pointer;
  }
  .send button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .or {
    color: var(--dim);
    font-size: 15px;
  }
  .status {
    margin: 0;
    font-size: 15.5px;
  }
  .status:empty {
    display: none;
  }
  .status.error {
    color: #ff6a5a;
    font-weight: 600;
  }
  /* Made by the script when the form sends, so it isn't scoped. */
  :global(.sent) {
    margin-top: 30px;
    padding: 22px;
    background: var(--deep);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  :global(.sent h3) {
    margin: 0;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  :global(.sent p) {
    margin: 10px 0 0;
    color: var(--dim);
  }

  /* ---------- questions ---------- */
  .faq {
    padding-top: clamp(90px, 12vw, 150px);
    max-width: 1040px;
  }
  .faq dl {
    margin: 36px 0 0;
    border-top: 1px solid var(--line);
  }
  .qa {
    display: grid;
    gap: 6px 40px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 820px) {
    .qa {
      grid-template-columns: 2fr 3fr;
    }
  }
  .qa dt {
    font-weight: 700;
  }
  .qa dd {
    margin: 0;
    color: var(--dim);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("form[data-sales]");
  if (form) {
    const status = form.querySelector<HTMLElement>(".status")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

    const mark = (field: string | undefined) => {
      form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
      if (!field) return;
      const el = field === "size" ? form.querySelector<HTMLElement>("#size") : form.querySelector<HTMLElement>(`#${field}`);
      el?.setAttribute("aria-invalid", "true");
      (field === "size" ? form.querySelector<HTMLInputElement>("input[name=size]") : (el as HTMLInputElement | null))?.focus();
    };
    const fail = (message: string, field?: string) => {
      status.className = "status error";
      status.textContent = message;
      mark(field);
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const missing = (["name", "email", "company", "size"] as const).find((name) => !String(data.get(name) ?? "").trim());
      if (missing) {
        const words = { name: "Add your name.", email: "Add an email address we can reply to.", company: "Add the company's name.", size: "Choose how many people will use nykma." };
        return fail(words[missing], missing);
      }

      button.disabled = true;
      button.textContent = "sending…";
      status.className = "status";
      status.textContent = "";
      try {
        const response = await fetch(form.action, { method: "POST", body: data, headers: { accept: "application/json" } });
        const result = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string; field?: string };
        if (!response.ok || !result.ok) {
          fail(result.error ?? "It didn't send. Email sales@nobodyknowsmyapp.com instead.", result.field);
          return;
        }
        const email = String(data.get("email"));
        const done = document.createElement("div");
        done.className = "sent";
        done.innerHTML = `<h3>Sent to sales.</h3><p>The reply will come to <strong></strong>. If it doesn't arrive, email <a href="mailto:sales@nobodyknowsmyapp.com">sales@nobodyknowsmyapp.com</a>.</p>`;
        done.querySelector("strong")!.textContent = email;
        done.tabIndex = -1;
        form.replaceWith(done);
        done.focus();
      } catch {
        fail("It didn't send: the connection dropped. Try again, or email sales@nobodyknowsmyapp.com.");
      } finally {
        button.disabled = false;
        button.textContent = "send to sales";
      }
    });
  }
</script>
