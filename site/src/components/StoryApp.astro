---
// myapp's screen in the scroll story (Story.astro): a made-up week planner, drawn at 180 × 400 and scaled or
// warped onto a phone by the page. Every task is ticked here; the story unticks them and ticks them again as it plays.
const tasks = ["Gym, 7:00", "Call mom", "Ship v1.2", "Dinner with Noa", "Plan next week"];
---

<div class="app" aria-hidden="true">
  <p class="app-top"><b>myapp</b><span>Mon 24</span></p>
  <p class="app-h">This week</p>
  <ul>{tasks.map((task) => <li class="done" data-task><i></i>{task}</li>)}</ul>
  <p class="app-btn" data-appbtn>Plan my week</p>
</div>

<style>
  .app {
    position: absolute;
    left: 0;
    top: 0;
    width: 180px;
    height: 400px;
    padding: 26px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fbf8f2;
    color: #141414;
    border-radius: 16px;
    font: 600 11px/1.3 var(--mono);
    transform-origin: 0 0;
    overflow: hidden;
  }
  .app p {
    margin: 0;
  }
  .app-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .app-top b {
    font-size: 13px;
    font-weight: 800;
  }
  .app-top span {
    color: rgba(20, 20, 20, 0.5);
    font-size: 10px;
  }
  .app-h {
    margin-top: 8px !important;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .app ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .app li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-radius: 9px;
    background: #fff;
    border: 1px solid rgba(20, 20, 20, 0.1);
    transition: color 0.2s;
  }
  .app li i {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid rgba(20, 20, 20, 0.35);
    display: grid;
    place-items: center;
    transition: background 0.2s, border-color 0.2s;
  }
  .app li.done {
    color: rgba(20, 20, 20, 0.45);
    text-decoration: line-through;
  }
  .app li.done i {
    background: #e8301f;
    border-color: #e8301f;
  }
  .app li.done i::after {
    content: "";
    width: 5px;
    height: 3px;
    border: solid #fff;
    border-width: 0 0 1.5px 1.5px;
    transform: rotate(-45deg) translateY(-1px);
  }
  .app-btn {
    margin-top: auto !important;
    padding: 11px;
    border-radius: 12px;
    background: #141414;
    color: #fff;
    text-align: center;
    font-weight: 800;
    transition: background 0.2s, transform 0.2s;
  }
  .app-btn.tap {
    background: #e8301f;
    transform: scale(0.95);
  }
</style>
