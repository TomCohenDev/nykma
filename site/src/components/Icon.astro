---
// The nykma icon (P1): a play button and a red cursor on a black tile. public/favicon.svg is the same drawing.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <rect width="64" height="64" rx="16" fill="#0b0b0d"></rect>
  <path d="M19 18.5 L37 30 L19 41.5 Z" fill="#fff" stroke="#fff" stroke-width="4" stroke-linejoin="round"></path>
  <rect x="34" y="42" width="15" height="5.5" rx="2.5" fill="#e8301f"></rect>
</svg>
