---
// "Every frame is code": the code that draws a small made-up ad for myapp, beside that ad at 16:9, 1:1 and 9:16 in
// 3D (scripts/frames3d.ts, three.js, loaded only when the section comes near the screen). The slider shows the point:
// the picture is a function of the frame number. With reduced motion it stands still on a late frame.
const tsx = `// src/ads/free-plan/Hook.tsx
import { useFrame, useVideo } from "../../engine";

export function Hook() {
  const frame = useFrame();       // 0, 1, 2 … at 30 fps
  const { ratio } = useVideo();   // "16x9", "1x1" or "9x16"
  const days = Math.min(7, Math.max(0, Math.floor((frame - 30) / 6)));

  return (
    <div className={\`hook hook-\${ratio}\`}>
      <b className="logo">myapp</b>
      <h1 data-fx="in:fade-up@12+15">Free. Forever.</h1>
      <ol className="week">
        {[..."MTWTFSS"].map((day, i) => (
          <li key={i} className={i < days ? "done" : ""}>{day}</li>
        ))}
      </ol>
      <p className="price" data-fx="in:fade@75+12">$0 a month</p>
    </div>
  );
}`;
const css = `/* src/ads/free-plan/hook.css */
.hook {
  position: absolute;
  inset: 0;
  padding: 76px;
  background: #fbf8f2;
  color: #141414;
  font-family: "JetBrains Mono", monospace;
}
.hook h1 {
  margin: 0;
  font-size: 162px;
  font-weight: 800;
  line-height: 1.02;
  letter-spacing: -0.04em;
}
.hook-16x9 h1 { font-size: 130px; }
.week { display: flex; gap: 17px; }
.week li { width: 113px; aspect-ratio: 1; border-radius: 19px; }
.week li.done { background: #e8301f; color: #fff; }`;

// A small highlighter, run at build time: comments, strings, keywords, JSX tags and numbers.
const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const highlight = (code: string, lang: "tsx" | "css") => {
  const rules: [RegExp, string][] =
    lang === "tsx"
      ? [
          [/\/\/[^\n]*/y, "c"],
          [/"[^"\n]*"|`[^`]*`/y, "s"],
          [/\b(?:import|from|export|function|const|return)\b/y, "k"],
          [/<\/?[A-Za-z][\w.]*|\/?>/y, "t"],
          [/\b(?:data-fx|className|key)\b/y, "a"],
          [/\b\d+(?:\.\d+)?\b/y, "n"],
          [/\b(?:useFrame|useVideo|Math)\b/y, "f"],
        ]
      : [
          [/\/\*[\s\S]*?\*\//y, "c"],
          [/"[^"\n]*"/y, "s"],
          [/[.#][\w-]+(?=[^{}\n]*\{)/y, "t"],
          [/[\w-]+(?=:)/y, "a"],
          [/#[0-9a-f]{3,6}\b/y, "n"],
          [/\b\d+(?:\.\d+)?(?:px|em)?\b/y, "n"],
        ];
  let out = "";
  let i = 0;
  let plain = "";
  while (i < code.length) {
    let hit: [string, string] | null = null;
    for (const [re, cls] of rules) {
      re.lastIndex = i;
      const m = re.exec(code);
      if (m && m[0].length) {
        hit = [m[0], cls];
        break;
      }
    }
    if (hit) {
      out += escape(plain) + `<span class="hl-${hit[1]}">${escape(hit[0])}</span>`;
      plain = "";
      i += hit[0].length;
    } else {
      // Step over a whole word, so a rule can't match the middle of one.
      const word = /[\w-]+|[\s\S]/y;
      word.lastIndex = i;
      const m = word.exec(code)!;
      plain += m[0];
      i += m[0].length;
    }
  }
  return out + escape(plain);
};
---

<section class="t-wrap fr" id="code">
  <p class="fr-tag">every frame is code</p>
  <h2 class="fr-h2">The video is a web page.</h2>
  <p class="fr-lede">
    An ad is a React component: HTML, CSS and TypeScript, every value worked out from the frame number. The same code
    draws every size and renders the same way twice. Read it, change it, or ask the agent to.
  </p>

  <div class="fr-grid">
    <figure class="fr-code">
      <div class="fr-tabs" role="tablist" aria-label="Files">
        <button type="button" role="tab" aria-selected="true" data-file="0">Hook.tsx</button>
        <button type="button" role="tab" aria-selected="false" data-file="1">hook.css</button>
      </div>
      <pre data-pane="0"><code set:html={highlight(tsx, "tsx")} /></pre>
      <pre data-pane="1" hidden><code set:html={highlight(css, "css")} /></pre>
    </figure>

    <div class="fr-view">
      <div class="fr-stage" data-frames aria-label="The same ad at 16:9, 1:1 and 9:16" role="img"></div>
      <div class="fr-controls">
        <button type="button" class="fr-play" aria-pressed="false" data-play>pause</button>
        <label class="fr-scrub">
          <span>frame <b data-frame>000</b></span>
          <input type="range" min="0" max="119" value="0" step="1" data-slider aria-label="Frame" />
        </label>
        <span class="fr-fps">30 fps</span>
      </div>
      <p class="fr-note">Three sizes, one component. Drag the frame: it's only a number.</p>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>("[data-frames]");
  const root = stage?.closest<HTMLElement>(".fr");
  if (stage && root) {
    // The file tabs
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-file]")];
    const panes = [...root.querySelectorAll<HTMLElement>("[data-pane]")];
    tabs.forEach((tab, i) =>
      tab.addEventListener("click", () => {
        tabs.forEach((other, j) => other.setAttribute("aria-selected", String(i === j)));
        panes.forEach((pane, j) => (pane.hidden = i !== j));
      }),
    );
    // three.js only when the section is close
    const load = () =>
      import("../scripts/frames3d").then(({ start }) =>
        start(stage, {
          frame: root.querySelector<HTMLElement>("[data-frame]")!,
          slider: root.querySelector<HTMLInputElement>("[data-slider]")!,
          play: root.querySelector<HTMLButtonElement>("[data-play]")!,
        }),
      );
    if ("IntersectionObserver" in window) {
      const near = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            near.disconnect();
            load();
          }
        },
        { rootMargin: "400px 0px" },
      );
      near.observe(stage);
    } else load();
  }
</script>

<style>
  .fr {
    padding-top: clamp(90px, 12vw, 150px);
  }
  .fr-tag {
    display: inline-block;
    margin: 0;
    padding: 3px 8px;
    font: 700 12px/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: 5px;
  }
  .fr-h2 {
    margin: 22px 0 0;
    font-weight: 800;
    font-size: clamp(28px, 3.8vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .fr-lede {
    margin: 22px 0 0;
    color: var(--dim);
    max-width: 66ch;
  }
  .fr-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 32px;
    margin-top: 40px;
    align-items: center;
  }
  .fr-code {
    margin: 0;
    background: var(--deep);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    min-width: 0;
  }
  .fr-tabs {
    display: flex;
    border-bottom: 1px solid var(--line);
  }
  .fr-tabs button {
    font: 600 13px/1 var(--mono);
    color: var(--dim);
    background: none;
    border: 0;
    border-right: 1px solid var(--line);
    padding: 11px 16px;
    cursor: pointer;
  }
  .fr-tabs button[aria-selected="true"] {
    color: var(--paper);
    background: var(--raise);
    box-shadow: inset 0 -2px 0 var(--red);
  }
  .fr-code pre {
    margin: 0;
    padding: 16px 18px 20px;
    overflow-x: auto;
    font: 400 13px/1.65 var(--mono);
    color: var(--paper);
    tab-size: 2;
  }
  .fr-code pre[hidden] {
    display: none;
  }
  .fr-code :global(.hl-c) {
    color: #77736b;
  }
  .fr-code :global(.hl-s) {
    color: #ffb4a8;
  }
  .fr-code :global(.hl-k) {
    color: var(--red);
    font-weight: 700;
  }
  .fr-code :global(.hl-t) {
    color: #d8d2c6;
    font-weight: 700;
  }
  .fr-code :global(.hl-a) {
    color: var(--dim);
  }
  .fr-code :global(.hl-n) {
    color: #ffb4a8;
  }
  .fr-code :global(.hl-f) {
    color: var(--paper);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 3px;
  }
  .fr-view {
    min-width: 0;
  }
  .fr-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    background: radial-gradient(ellipse at 50% 55%, #222 0%, var(--ink) 70%);
    border: 1px solid var(--line);
    overflow: hidden;
    touch-action: pan-y;
  }
  .fr-stage :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .fr-stage:global(.is-flat) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3%;
    padding: 6%;
  }
  .fr-stage:global(.is-flat) :global(canvas) {
    width: auto;
    height: auto;
    max-height: 100%;
    min-width: 0;
    flex: 0 1 auto;
  }
  .fr-controls {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 14px;
    font: 600 13px/1 var(--mono);
    color: var(--dim);
  }
  .fr-play {
    font: inherit;
    color: var(--dim);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 12px;
    cursor: pointer;
  }
  .fr-play:hover {
    color: var(--paper);
    border-color: var(--paper);
  }
  .fr-scrub {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .fr-scrub span {
    white-space: nowrap;
  }
  .fr-scrub b {
    color: var(--paper);
  }
  .fr-scrub input {
    flex: 1;
    min-width: 0;
    accent-color: var(--red);
  }
  .fr-note {
    margin: 10px 0 0;
    color: var(--dim);
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .fr-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .fr-view {
      order: -1;
    }
  }
  @media (max-width: 560px) {
    .fr-stage {
      aspect-ratio: 4 / 3.4;
    }
    .fr-code pre {
      font-size: 11.5px;
      padding: 14px 12px 16px;
    }
    .fr-fps {
      display: none;
    }
  }
</style>
