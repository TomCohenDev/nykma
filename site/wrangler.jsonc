// nobodyknowsmyapp.com on Cloudflare Workers: the built site in dist/, and worker/index.ts for /api/*.
// The sales form mails through Email Routing. SALES_TO is the verified address that receives it, set with
// `npx wrangler secret put SALES_TO` (and in .dev.vars locally), never written here: this file is public.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nykma-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [{ "name": "SALES" }],
  // Preview only, on workers.dev, until the public repo exists (the pages link to it). To go live, uncomment the
  // routes: the next deploy attaches nobodyknowsmyapp.com and www.nobodyknowsmyapp.com.
  "workers_dev": true,
  // "routes": [
  //   { "pattern": "nobodyknowsmyapp.com", "custom_domain": true },
  //   { "pattern": "www.nobodyknowsmyapp.com", "custom_domain": true }
  // ],
  "observability": { "enabled": true }
}
