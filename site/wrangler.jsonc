// nobodyknowsmyapp.com on Cloudflare Workers: the built site in dist/, and worker/index.ts for /api/*.
// The sales form mails through Email Routing. SALES_TO is the verified address that receives it, set with
// `npx wrangler secret put SALES_TO` (and in .dev.vars locally), never written here: this file is public.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nykma-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The worker sees every request first, so www can redirect to the bare domain; it hands the rest to the assets.
    "run_worker_first": true
  },
  "send_email": [{ "name": "SALES" }],
  // nobodyknowsmyapp.com and www (which redirects), with the workers.dev preview kept on too.
  "workers_dev": true,
  "routes": [
    { "pattern": "nobodyknowsmyapp.com", "custom_domain": true },
    { "pattern": "www.nobodyknowsmyapp.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
